{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🔨 build",
            "type": "shell",
            "command": "make",
            "args": ["build"],
            "group": {"kind": "build", "isDefault": true},
            "options": {
                "shell": {
                    "executable": "powershell.exe",
                    "args": ["-Command"]
                },
                "env": {
                    "PATH": "C:\\Users\\29344\\.eide\\bin\\builder\\msys\\bin;${env:PATH}"
                }
            },
            "problemMatcher": ["$gcc"],
            "presentation": {"reveal": "always", "panel": "dedicated"}
        },
        {
            "label": "🧹 clean",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "group": "build",
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/c"]
                },
                "env": {
                    "PATH": "C:\\Users\\29344\\.eide\\bin\\builder\\msys\\bin;${env:PATH}"
                }
            }
        },
        {
            "label": "🔄 rebuild",
            "type": "shell",
            "command": "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; make rebuild",
            "group": "build",
            "options": {
                "shell": {
                    "executable": "pwsh.exe",
                    "args": ["-Command"]
                },
                "env": {
                    "PATH": "C:\\Users\\29344\\.eide\\bin\\builder\\msys\\bin;${env:PATH}"
                }
            }
        },
        {
            "label": "🔥 probe-rs download (flash)",
            "type": "shell",
            "command": "${workspaceFolder}\\tools\\probe-rs-src\\target\\release\\probe-rs.exe",
            "args": [
                "download",
                "--chip", "CYT2BL3BAS",
                "--protocol", "swd",
                "--binary-format", "elf",
                "${workspaceFolder}\\build\\firmware.elf"
            ],
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/c"]
                },
                "env": {
                    "RUST_LOG": "probe_rs=info"
                }
            },
            "group": {"kind": "test", "isDefault": true},
            "dependsOn": ["🔨 build"],
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
        },
        

    ]
}
