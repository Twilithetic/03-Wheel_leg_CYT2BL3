        {
            "label": "🔥 OpenOCD 烧录 (WCH-Link)",
            "type": "shell",
            "command": "make",
            "args": ["flash"],
            "group": {"kind": "test", "isDefault": true},
            "dependsOn": ["🔨 build"],
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/c"]
                },
                "env": {
                    "PATH": "C:\\Users\\29344\\.eide\\bin\\builder\\msys\\bin;${env:PATH}"
                }
            },
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
        },
        {
            "label": "🔥 仅烧录 (不编译)",
            "type": "shell",
            "command": "make",
            "args": ["flash"],
            "group": "test",
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/c"]
                },
                "env": {
                    "PATH": "C:\\Users\\29344\\.eide\\bin\\builder\\msys\\bin;${env:PATH}"
                }
            },
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
        },
        {
            "label": "🔍 OpenOCD 检测芯片 (WCH-Link)",
            "type": "shell",
            "command": "${workspaceFolder}\\tools\\infineon-openocd\\bin\\openocd.exe",
            "args": [
                "-s", "${workspaceFolder}\\tools\\infineon-openocd\\scripts",
                "-f", "interface/cmsis-dap.cfg",
                "-c", "adapter serial F3EE7D40070E",
                "-f", "target/infineon/cyt2bl.cfg",
                "-c", "init",
                "-c", "targets",
                "-c", "shutdown"
            ],
            "group": "test",
            "options": {
                "shell": {
                    "executable": "pwsh.exe",
                    "args": ["-Command"]
                }
            },
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
        },
        {
            "label": "📡 启动 GDB Server (WCH-Link)",
            "type": "shell",
            "command": "${workspaceFolder}\\tools\\infineon-openocd\\bin\\openocd.exe",
            "args": [
                "-s", "${workspaceFolder}\\tools\\infineon-openocd\\scripts",
                "-f", "interface/cmsis-dap.cfg",
                "-c", "adapter serial F3EE7D40070E",
                "-f", "target/infineon/cyt2bl.cfg"
            ],
            "isBackground": true,
            "group": "test",
            "options": {
                "shell": {
                    "executable": "pwsh.exe",
                    "args": ["-Command"]
                }
            },
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": [
                {
                    "pattern": {
                        "regexp": "Listening on port (\\d+) for gdb connections",
                        "message": 1
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "Listening on port",
                        "endsPattern": "Listening on port"
                    }
                }
            ]
        },
